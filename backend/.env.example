# Giliran backend configuration.
# Copy to .env and fill in the blanks: cp .env.example .env
# Loaded by pkg/config (koanf). Real environment variables override this file.
# Durations use Go syntax (15m, 24h, 720h). Sizes are in bytes.

# ---------- App ----------
APP_NAME=giliran
# development | staging | production
APP_ENV=development
# business dates (due date, draw date)
APP_TIMEZONE=Asia/Jakarta
# invite (/j/), claim (/c/) and Bukti Kocok links; prod: https://giliran.monai.my.id
APP_PUBLIC_BASE_URL=http://localhost:8080

# ---------- HTTP (cmd/api) ----------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# 6 MB: 5 MB proof upload plus multipart overhead
HTTP_BODY_LIMIT=6291456
# comma-separated; set to the Cloudflare Tunnel / Dokploy proxy in prod
HTTP_TRUSTED_PROXIES=
HTTP_CORS_ALLOW_ORIGINS=http://localhost:8080

# ---------- Logging ----------
# debug | info | warn | error
LOG_LEVEL=debug
# text | json (use json in production)
LOG_FORMAT=text

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://giliran:CHANGE_ME@localhost:5432/giliran?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Used by the postgres container in deploy/docker-compose.*.yml; keep in sync with DATABASE_URL.
POSTGRES_USER=giliran
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=giliran

# ---------- Auth: JWT ----------
# at least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=giliran-api
JWT_AUDIENCE=giliran-app
JWT_ACCESS_TTL=15m
# 30 days, rotated on every refresh
JWT_REFRESH_TTL=720h

# ---------- Auth: PIN (argon2id) ----------
PIN_ARGON2_MEMORY_KIB=65536
PIN_ARGON2_ITERATIONS=3
PIN_ARGON2_PARALLELISM=2
PIN_ARGON2_SALT_LENGTH=16
PIN_ARGON2_KEY_LENGTH=32
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_DURATION=15m

# ---------- Firebase (phone auth + FCM) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# ---------- MinIO (payment proofs, avatars, QRIS images) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=giliran
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=giliran
MINIO_PRESIGN_TTL=15m
# 5 MB, returns 413 file_too_large above this
UPLOAD_MAX_BYTES=5242880

# Used by the minio container in deploy/docker-compose.*.yml; keep in sync with the keys above.
MINIO_ROOT_USER=giliran
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---------- Rate limits (Fiber limiter, per client) ----------
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW=15m
RATE_LIMIT_PIN_MAX=10
RATE_LIMIT_PIN_WINDOW=15m
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW=1m
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_PUBLIC_WINDOW=1m

# ---------- Idempotency ----------
IDEMPOTENCY_TTL=24h

# ---------- Worker (cmd/worker, River) ----------
WORKER_MAX_WORKERS=10
# daily payment reminders, in APP_TIMEZONE
WORKER_REMINDER_CRON="0 9 * * *"
# expired idempotency keys, sessions, proofs
WORKER_CLEANUP_CRON="0 3 * * *"

# ---------- Retention (DB_SCHEME §10) ----------
RETENTION_IDEMPOTENCY_KEYS=24h
# 30 days
RETENTION_REVOKED_SESSIONS=720h
# 90 days after the group completes or closes
RETENTION_PAYMENT_PROOFS=2160h
