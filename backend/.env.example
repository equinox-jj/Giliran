# Giliran backend configuration.
# Copy to .env and fill in the blanks: cp .env.example .env
# Loaded by pkg/config (koanf). Real environment variables override this file.
# Only values without a sensible default are listed here. Every other setting
# (timeouts, pool sizes, TTLs, rate limits, worker crons, retention...) has a
# default in pkg/config/config.go and can be overridden by adding its
# variable, e.g. HTTP_PORT=9090. Durations use Go syntax (15m, 24h, 720h).

# ---------- App ----------
# development | staging | production
APP_ENV=development
# invite (/j/), claim (/c/) and Bukti Kocok links; prod: https://giliran.monai.my.id
APP_PUBLIC_BASE_URL=http://localhost:8080

# ---------- Logging ----------
# debug | info | warn | error (default info)
LOG_LEVEL=debug
# text | json (default json)
LOG_FORMAT=text

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://giliran:CHANGE_ME@localhost:5432/giliran?sslmode=disable

# Used by the postgres container in deploy/docker-compose.*.yml; keep in sync with DATABASE_URL.
POSTGRES_USER=giliran
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=giliran

# ---------- Auth: JWT ----------
# at least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=

# ---------- Auth: Firebase (phone OTP) ----------
# The API will not start without a service-account key. Firebase console >
# Project settings > Service accounts > Generate new private key, then save it
# as backend/secrets/firebase-service-account.json (git-ignored). Docker
# Compose mounts backend/secrets at /secrets and sets the path for you.
# FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
# Optional; read from the key file when empty.
# FIREBASE_PROJECT_ID=

# ---------- MinIO (payment proofs, avatars, QRIS images) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=giliran
MINIO_SECRET_KEY=CHANGE_ME

# Used by the minio container in deploy/docker-compose.*.yml; keep in sync with the keys above.
MINIO_ROOT_USER=giliran
MINIO_ROOT_PASSWORD=CHANGE_ME
