# Giliran backend configuration.
# Copy to .env and fill in the blanks: cp .env.example .env
# Loaded by pkg/config (koanf). Real environment variables override this file.
# Only values that dev or production needs are listed here. Every other setting
# (log level, timeouts, pool sizes, TTLs, rate limits, worker crons, retention...)
# has a default in pkg/config/config.go and can be overridden by adding its
# variable, e.g. LOG_LEVEL=debug. Durations use Go syntax (15m, 24h, 720h).

# ---------- App ----------
# development | staging | production
APP_ENV=development
# invite (/j/), claim (/c/) and Bukti Kocok links; prod: https://giliran.monai.my.id
APP_PUBLIC_BASE_URL=http://localhost:8080

# debug | info | warn | error (default info)
LOG_LEVEL=debug
# text | json (default json)
LOG_FORMAT=text

# ---------- HTTP ----------
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted. Empty in dev;
# required behind the Cloudflare Tunnel in production, or per-IP rate limits see
# only the tunnel's address.
HTTP_TRUSTED_PROXIES=

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://giliran:CHANGE_ME@localhost:5432/giliran?sslmode=disable

# Used by the postgres container in deploy/docker-compose.*.yml; keep in sync with DATABASE_URL.
POSTGRES_USER=giliran
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=giliran

# ---------- Auth: JWT ----------
# at least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=

# ---------- Auth: email OTP ----------
# Keys the sign-in code derivation and the stored code hash. At least 32 bytes;
# the API and the worker must share it. Generate with: openssl rand -hex 32
OTP_SECRET=

# ---------- Email (SMTP; only the worker sends) ----------
# Dev: Mailpit from the dev Compose file (SMTP_HOST=mailpit, or localhost for
# go run; SMTP_PORT=1025; SMTP_TLS=none; no credentials; inbox at :8025).
# Prod: Resend (smtp.resend.com, 587, starttls, username "resend", the API key
# as password). Switching provider is only a change here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | tls | none (default starttls; none is refused in production)
SMTP_TLS=none

# ---------- MinIO (payment proofs, avatars, QRIS images) ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=giliran
MINIO_SECRET_KEY=CHANGE_ME
# Origin the app downloads avatars/proofs from; presigned URLs are signed for it,
# so a proxy in front of MinIO must keep the Host header. Empty: MINIO_ENDPOINT.
# Required in production (https://<files hostname>). Dev: emulator
# http://10.0.2.2:9000, phone http://<LAN IP>:9000.
MINIO_PUBLIC_URL=

# Used by the minio container in deploy/docker-compose.*.yml; keep in sync with the keys above.
MINIO_ROOT_USER=giliran
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---------- Firebase (FCM push; worker only) ----------
# No variable needed: the worker reads ./secrets/firebase-service-account.json
# (Compose mounts backend/secrets at /secrets and sets the path) and will not
# start without it. Firebase console > Project settings > Service accounts >
# Generate new private key, then save it there (backend/secrets is git-ignored).
FIREBASE_CREDENTIALS_FILE=

# ---------- Backups (production; read by deploy/backup/backup.sh, not the API) ----------
# Any S3-compatible remote off the home server (Cloudflare R2, Backblaze B2, ...).
# The bucket must already exist. Dumps are kept 30 days (BACKUP_RETENTION_DAYS).
# Run: docker compose -f deploy/docker-compose.prod.yml run --rm backup
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
